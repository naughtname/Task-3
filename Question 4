# 1. Sum of first N natural numbers
def sum_n(n):
  if n <= 1:
    return n
  return n + sum_n(n - 1)


# 2. Factorial of a number
def factorial(n):
  if n == 0 or n == 1:
    return 1
  return n * factorial(n - 1)


# 3. Nth term of a Fibonacci series
def fibonacci_nth(n):
  if n <= 0:
    return 0
  elif n == 1:
    return 1
  return fibonacci_nth(n - 1) + fibonacci_nth(n - 2)


# 4. Generate N terms of a Fibonacci series (Helper function)
def generate_fibonacci(n, list_fib=[]):
  if n <= 0:
    return []
  elif n == 1:
    return [0]
  elif len(list_fib) == 0:
    list_fib = [0, 1]

  if len(list_fib) < n:
    list_fib.append(list_fib[-1] + list_fib[-2])
    generate_fibonacci(n, list_fib)
  return list_fib
